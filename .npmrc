# 项目级 registry 覆盖。
#
# 全局 ~/.npmrc 指向阿里内网镜像（工作项目需要），但这是个人项目、依赖全是公网包，
# 而内网镜像缺 pnpm 自身的平台包（@pnpm/exe.*），会导致 ERR_PNPM_BAD_CONFIG_DEP。
# 这个文件只对本仓库生效，不影响全局配置。
registry=https://registry.npmjs.org/

# 关掉 pnpm 的自版本管理。
# 开启时（pnpm 10+ 默认）它会按 packageManager 字段去下载 @pnpm/exe.<platform>，
# 而这个解析发生在 bootstrap 阶段、绕过项目级 .npmrc 直接读 ~/.npmrc，
# 于是走到内网镜像并报 ERR_PNPM_BAD_CONFIG_DEP。
manage-package-manager-versions=false

# 锁文件里也记录公网 registry，避免别人 clone 后被自己的全局配置带偏
resolution-mode=highest
